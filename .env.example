# Copiar como .env y completar. Nunca commitear .env.

# Django
SECRET_KEY=generar-una-clave-propia
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Docker Compose fuerza DB_HOST=db dentro del contenedor web).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db
DB_USER=postgres
DB_PASSWORD=cambiar-esta-clave

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=

# Fuentes de noticias / scraping
ELTERRITORIO_RSS_URL=

# Configuración de tareas automáticas
TIME_ZONE=America/Argentina/Buenos_Aires

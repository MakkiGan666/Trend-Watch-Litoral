# Copiar como .env y completar. Nunca commitear .env.

# Django
SECRET_KEY=generar-una-clave-propia
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (Docker Compose fuerza DB_HOST=db dentro del contenedor web).
# Fuera de Docker, dejar DB_HOST vacío para usar SQLite (app/db.sqlite3).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db
DB_USER=postgres
DB_PASSWORD=cambiar-esta-clave

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=
# Segundos máximos de espera de Gemini (predeterminado 60); superado, cuenta como fallo temporal.
GEMINI_TIMEOUT=

# Ollama (motor local alternativo; se elige en el panel «Motor de Inteligencia Artificial»).
# Con Docker Desktop usar http://host.docker.internal:11434 (localhost sería el propio contenedor).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODELO_CHAT=llama3.1:latest
OLLAMA_TIMEOUT=60

# Fuentes de noticias / scraping
ELTERRITORIO_RSS_URL=

# Configuración de tareas automáticas
TIME_ZONE=America/Argentina/Buenos_Aires
